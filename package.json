{
  "name": "crux",
  "version": "0.1.0",
  "description": "Personal project manager with CPM, ROI tracking, and local LLM routing.",
  "type": "module",
  "bin": {
    "crux": "./index.ts"
  },
  "scripts": {
    "test": "node --test test/unit/**/*.test.ts",
    "test:agent": "node --test test/integration/**/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "node --check index.ts lib/**/*.ts",
    "typecheck": "tsgo --noEmit",
    "format": "echo 'no formatter configured'",
    "bundle": "node esbuild.config.mjs",
    "dev": "node index.ts ui --no-open",
    "build": "npm run bundle",
    "preview": "node dist/crux.cjs ui --no-open"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=25.0.0"
  },
  "keywords": ["project-management", "cpm", "critical-path", "mcp", "mcpb"],
  "license": "MIT",
  "author": {
    "name": "sholtomaud"
  }
}
